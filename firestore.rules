rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function belongsToTenant(tenantId) {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.tenantId == tenantId
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'OWNER'
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active != false;
    }

    function isBuiltInPosTenant(tenantId) {
      return tenantId.matches('store[0-9]+') || tenantId == 'AromataZoisAgiouDimitriou';
    }

    function isActiveEmployee(tenantId) {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.tenantId == tenantId
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'EMPLOYEE'
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active != false
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.employeeId is string
        && exists(/databases/$(database)/documents/tenants/$(tenantId)/employees/$(get(/databases/$(database)/documents/users/$(request.auth.uid)).data.employeeId))
        && get(/databases/$(database)/documents/tenants/$(tenantId)/employees/$(get(/databases/$(database)/documents/users/$(request.auth.uid)).data.employeeId)).data.active != false;
    }

    function employeeCanReadReceivingData(tenantId, collectionName) {
      return collectionName in ['brands', 'categories', 'consumables', 'inventory', 'products', 'variantTemplates']
        && isActiveEmployee(tenantId);
    }

    function publicPosCanRead(tenantId, collectionName) {
      return request.auth == null
        && isBuiltInPosTenant(tenantId)
        && collectionName in ['categories', 'employees', 'orders', 'products', 'promotions', 'variantTemplates'];
    }

    match /tenants/{tenantId}/{collectionName}/{document=**} {
      allow read: if collectionName in [
        'brands', 'categories', 'consumables', 'employees', 'expenses', 'inventory',
        'orders', 'products', 'promotions', 'stockMovements', 'variantTemplates', 'variants'
      ] && (belongsToTenant(tenantId) || employeeCanReadReceivingData(tenantId, collectionName) ||
        publicPosCanRead(tenantId, collectionName));
      allow write: if false;
    }

    match /tenants/{tenantId}/employeeAccounts/{employeeId} {
      allow read: if belongsToTenant(tenantId);
      allow write: if false;
    }

    match /users/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function belongsToTenant(tenantId) {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.tenantId == tenantId;
    }

    function isBuiltInPosTenant(tenantId) {
      return tenantId.matches('store[0-9]+');
    }

    match /tenants/{tenantId}/{collectionName}/{document=**} {
      allow read: if collectionName in [
        'brands', 'categories', 'consumables', 'employees', 'inventory',
        'orders', 'products', 'stockMovements', 'variantTemplates', 'variants'
      ] && (belongsToTenant(tenantId) || isBuiltInPosTenant(tenantId));
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}